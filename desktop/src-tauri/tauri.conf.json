{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitals",
  "version": "2.1.0",
  "identifier": "org.vitals.desktop",
  "build": { "frontendDist": "../startup" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
